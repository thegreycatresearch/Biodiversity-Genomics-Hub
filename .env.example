# Copiá este archivo a ".env" y completá tus credenciales.

# NCBI Entrez (GenBank) — gratis, solo requiere un email de contacto.
NCBI_EMAIL=tu-email@ejemplo.com
# Opcional: sube el límite de 3 a 10 requests/seg. Se pide en:
# https://www.ncbi.nlm.nih.gov/account/settings/
NCBI_API_KEY=

# IUCN Red List API v4 — gratis, pedila en https://api.iucnredlist.org/
IUCN_API_TOKEN=

# Base de datos (por defecto SQLite local, no requiere configuración)
DATABASE_URL=sqlite+aiosqlite:///./biodiversity_hub.db
